      "source_file": "CODE_REVIEW.md"
    },
    {
      "id": "vuln_no_auth",
      "label": "CRITICAL-1: No Authentication",
      "type": "vulnerability",
      "properties": {
        "severity": "critical",
        "status": "open",
        "description": "Zero authentication — no login, no password, no user accounts, no roles",
        "impact": "Anyone who opens the app has full unrestricted access",
        "legal": "Violates IT Rules 2011 requirement for access control on SPDI"
      },
      "source_file": "SECURITY_AUDIT.md"
    },
    {
      "id": "vuln_unencrypted_db",
      "label": "CRITICAL-2: Unencrypted Patient Data on Disk",
      "type": "vulnerability",
      "properties": {
        "severity": "critical",
        "status": "open",
        "description": "SQLite database stored as plain unencrypted file",
        "impact": "Laptop theft = full data breach",
        "legal": "Potential liability up to Rs. 250 crore under DPDPA 2023",
        "recommended_fix": "SQLCipher for AES-256 encryption or field-level encryption"
      },
      "source_file": "SECURITY_AUDIT.md"
    },
    {
      "id": "vuln_no_access_control",
      "label": "CRITICAL-3: No Object-Level Access Control (IDOR)",
      "type": "vulnerability",
      "properties": {
        "severity": "critical",
        "status": "open",
        "description": "Every data access method accepts an integer ID with no authorization check"
      },
      "source_file": "SECURITY_AUDIT.md"
    },
    {
      "id": "vuln_toctou_payment",
      "label": "HIGH-1: TOCTOU Race Condition in Payment Processing",
      "type": "vulnerability",
      "properties": {
        "severity": "high",
        "status": "open",
        "file": "src/services/payment_service.py",
        "description": "Payment validation and creation not atomic — double payment possible"
      },
      "source_file": "SECURITY_AUDIT.md"
    },
    {
      "id": "vuln_sql_injection_limit",
      "label": "HIGH-2: SQL Injection in LIMIT Clauses",
      "type": "vulnerability",
      "properties": {
        "severity": "high",
        "status": "open",
        "file": "src/repositories/patient_repository.py",
        "description": "LIMIT parameter inserted via f-string in get_recent_patients()"
      },
      "source_file": "SECURITY_AUDIT.md"
    },
    {
      "id": "vuln_no_db_constraints",
      "label": "HIGH-3: No Database Integrity Constraints",
      "type": "vulnerability",
      "properties": {
        "severity": "high",
        "status": "open",
        "file": "src/database/migrations.py",
        "description": "Missing UNIQUE on mobile, no CHECK constraints on amounts/ages"
      },
      "source_file": "SECURITY_AUDIT.md"
    },
    {
      "id": "vuln_pii_in_logs",
      "label": "HIGH-4: Sensitive Data in Logs",
      "type": "vulnerability",
      "properties": {
        "severity": "high",
        "status": "open",
        "file": "src/database/db_manager.py",
        "description": "Failed SQL queries logged with full query text including PII"
      },
      "source_file": "SECURITY_AUDIT.md"
    },
    {
      "id": "attack_chain_stolen_laptop",
      "label": "Attack Chain: Complete Data Breach (Stolen Laptop)",
