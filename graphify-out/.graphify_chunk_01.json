    {
      "id": "rationale_atomic_sql",
      "label": "Rationale: Atomic SQL for Payment Consistency",
      "type": "rationale",
      "properties": {
        "explanation": "Changed from read-then-write to atomic SQL UPDATE (amount_paid = amount_paid + ?) to prevent double-counting payments due to race conditions between concurrent reads and writes",
        "trade_off": "Slightly more complex SQL but eliminates data corruption risk"
      },
      "source_file": "CODE_REVIEW.md"
    },
    {
      "id": "rationale_offline_first",
      "label": "Rationale: Offline-First Architecture",
      "type": "rationale",
      "properties": {
        "explanation": "Chose SQLite over cloud database because dental clinics may not have reliable internet; the app must work fully offline with no external dependencies",
        "trade_off": "No multi-device sync or cloud backup, but guarantees availability"
      },
      "source_file": "claude.md"
    },
    {
      "id": "rationale_cursor_ui",
      "label": "Rationale: Cursor-Inspired UI Design",
      "type": "rationale",
      "properties": {
        "explanation": "Chose clean light theme inspired by Cursor.com for professional appearance; sidebar navigation with grouped menu items for intuitive workflow",
        "trade_off": "Hardcoded Segoe UI font may not be available on all machines"
      },
      "source_file": "claude.md"
    },
    {
      "id": "rationale_repository_pattern",
      "label": "Rationale: Repository Pattern for Data Access",
      "type": "rationale",
      "properties": {
        "explanation": "Separates data access from business logic for clean architecture; enables changing database implementation without modifying business rules",
        "trade_off": "Additional abstraction layer adds code but improves maintainability"
      },
      "source_file": "claude.md"
    },
    {
      "id": "rationale_single_exe",
      "label": "Rationale: Single Executable Distribution",
      "type": "rationale",
      "properties": {
        "explanation": "PyInstaller bundles entire Python runtime into one ~95 MB executable so doctor can run without installing Python or dependencies",
        "trade_off": "Large file size (~95 MB) but zero setup required for end user"
      },
      "source_file": "PACKAGING_GUIDE.md"
    },
    {
      "id": "rationale_no_auth_warning",
      "label": "Rationale: No Authentication (Security Risk)",
      "type": "rationale",
      "properties": {
        "explanation": "Authentication was not implemented in v1.0.0, likely for speed of initial development; security audit identifies this as the top risk requiring architectural changes for regulatory compliance",
        "trade_off": "Faster development but critical security gap violating IT Rules 2011 and DPDPA 2023"
      },
      "source_file": "SECURITY_AUDIT.md"
    },
