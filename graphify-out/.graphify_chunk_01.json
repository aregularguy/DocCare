    {
      "id": "bug_race_condition_payment",
      "label": "Race Condition in Payment Addition (Bug #1)",
      "type": "bug",
      "properties": {
        "severity": "critical",
        "status": "fixed",
        "file": "src/services/payment_service.py, src/repositories/treatment_repository.py",
        "fix": "Atomic SQL UPDATE instead of read-then-write"
      },
      "source_file": "CODE_REVIEW.md"
    },
    {
      "id": "bug_no_rollback",
      "label": "No Transaction Rollback on DB Errors (Bug #4)",
      "type": "bug",
      "properties": {
        "severity": "critical",
        "status": "fixed",
        "file": "src/database/db_manager.py",
        "fix": "try/except with conn.rollback() on failure"
      },
      "source_file": "CODE_REVIEW.md"
    },
    {
      "id": "bug_html_injection",
      "label": "HTML Injection in Prescription PDF (Bug #6)",
      "type": "bug",
      "properties": {
        "severity": "high",
        "status": "fixed",
        "file": "src/ui/dialogs/patient_details.py",
        "fix": "Added html.escape() for patient data in HTML template"
      },
      "source_file": "CODE_REVIEW.md"
    },
    {
      "id": "bug_sql_injection",
      "label": "SQL Injection Pattern in Repositories (Bug #17)",
      "type": "bug",
      "properties": {
        "severity": "medium",
        "status": "fixed",
        "file": "src/repositories/base_repository.py, src/repositories/payment_repository.py",
        "fix": "Added _validate_identifier() regex whitelist, parameterized LIMIT"
      },
      "source_file": "CODE_REVIEW.md"
    },
    {
      "id": "bug_widget_memory_leak",
      "label": "Widget Memory Leak on Tab Switches (Bug #18)",
      "type": "bug",
      "properties": {
        "severity": "medium",
        "status": "fixed",
        "file": "src/ui/dialogs/patient_details.py",
        "fix": "Added QApplication.processEvents() after deleteLater()"
      },
      "source_file": "CODE_REVIEW.md"
    },
    {
      "id": "bug_thread_safety",
      "label": "Thread Safety with check_same_thread=False (Bug #19)",
      "type": "bug",
      "properties": {
        "severity": "medium",
        "status": "fixed",
        "file": "src/database/db_manager.py",
        "fix": "Added thread check warning in get_connection()"
